    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opennextjs/cloudflare": "^1.20.1",
    "@prisma/adapter-d1": "^6.19.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.5.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "google-auth-library": "^10.9.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "pusher": "^5.3.4",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.24.0",
    "stripe": "^22.4.0",
    "swr": "^2.4.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
